  effects {
    at_millis: 1600
    sound { sound_id: "meridian_witch:spray_trigger.spit"
      volume { value: 0.6 unit: RATIO }
      pitch { value: 1.1 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 1600
    use_brew { processor_id: "meridian_brewing:use_brew"
      brew_kind_ids: "meridian_brewing:depletion"
      brew_kind_ids: "meridian_brewing:armor_rot"
      brew_kind_ids: "meridian_brewing:insect_lure"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      brew_kind_ids: "meridian_brewing:charm"
      use_methods: DRINK
      use_methods: SPLASH
      technique {
        method: MIST
        strength_multiplier: 0.5
        duration_multiplier: 0.5
        strength_quality_steps: 0
        maximum_quality_multiplier: 1
        nausea_multiplier: 1
        residue_dose: 0
        range { value: 16 unit: METER }
      } }
  }
  presentation { icon_id: "meridian_witch:spray_trigger" display_name: "噀催"
    description: "这是下卷压底的功夫。嘴里含一口同一种药，不管是喝的还是喷溅的，用胸腹力气猛喷出去，嘴前起一蓬 3 格远的药雾。起手 1.6 秒，缓 1 秒收手，耗 0.4 元气态真元，挨打会断。只要在 16 格以内，哪怕隔着墙，身上带着你下的同一味药引的人药性都会再发作一次，力道和时长只剩一半，药引散得越薄发作越轻。人死了或喝了牛奶药引就没了，记着，隔 8 秒才能再催。" }
}
