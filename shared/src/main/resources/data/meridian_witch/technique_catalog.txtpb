schema_version: 1
namespace: "meridian_witch"
binding_template_groups: "human:humanoid"
books { id: "meridian_witch:brew_arts" display_name: "行药诀" }
volumes {
  id: "meridian_witch:guard"
  book_id: "meridian_witch:brew_arts"
  display_name: "养"
  techniques { id: "meridian_witch:imbibe" version: 1 }
  techniques { id: "meridian_witch:anoint" version: 1 }
  # 生存来源：玩家亲手杀死会这一卷的女巫（Threatening 学卷表的游炁、真炁两档）时掉一卷，概率占位。
  scroll_drops { entity_type: "minecraft:witch" chance: 0.25 }
}
volumes {
  id: "meridian_witch:seed"
  book_id: "meridian_witch:brew_arts"
  display_name: "引"
  prerequisite_volume_ids: "meridian_witch:guard"
  techniques { id: "meridian_witch:lob_seed" version: 1 }
  techniques { id: "meridian_witch:fling_seed" version: 1 }
  techniques { id: "meridian_witch:spray_trigger" version: 1 }
  # 生存来源同《养》；学卷表里只有真炁女巫会《引》。
  scroll_drops { entity_type: "minecraft:witch" chance: 0.25 }
}
definitions {
  id: "meridian_witch:imbibe"
  version: 1
  category: RECOVERY
  minimum_realm: WANDERING_QI
  movement_speed_multiplier: 0.4
  brew_item {
    kind_ids: "meridian_brewing:bitter_yellow"
    kind_ids: "meridian_brewing:qi_gather"
    physical_uses: DRINK
    empty_off_hand: false
  }
  slots {
    id: "meridians"
    module: MERIDIAN
    tags: "human:foot_meridian"
    minimum_count: 1
    maximum_count: 6
    require_opened: true
  }
  cost {
    qi {
      slot_id: "meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: FREE
      amount { value: 0.3 unit: QI }
      distribution: EVEN
    }
  }
  phases {
    warmup_millis: 3200
    active_millis: 0
    recovery_millis: 1800
    interruptible_by_damage: true
  }
  cooldown_millis: 15000
  effects { at_millis: 0 presentation { id: "meridian_witch:witch_imbibe" duration: UNTIL_RECOVERY_END start_millis: 0 } }
  effects {
    at_millis: 300
    sound { sound_id: "meridian_witch:cork"
      volume { value: 0.5 unit: RATIO }
      pitch { value: 1.8 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 900
    sound { sound_id: "meridian_witch:imbibe.sip"
      volume { value: 0.5 unit: RATIO }
      pitch { value: 1.2 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 1500
    sound { sound_id: "meridian_witch:imbibe.sip"
      volume { value: 0.5 unit: RATIO }
      pitch { value: 1.2 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 2100
    sound { sound_id: "meridian_witch:imbibe.sip"
      volume { value: 0.5 unit: RATIO }
      pitch { value: 1.2 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 2400
    sound { sound_id: "meridian_witch:imbibe.stroke"
      volume { value: 0.3 unit: RATIO }
      pitch { value: 1.4 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 2850
    sound { sound_id: "meridian_witch:imbibe.stroke"
      volume { value: 0.3 unit: RATIO }
      pitch { value: 1.4 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 3200
    use_brew { processor_id: "meridian_brewing:use_brew"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      brew_kind_ids: "meridian_brewing:qi_gather"
      use_methods: DRINK
      technique {
        method: DRINK
        strength_multiplier: 1
        duration_multiplier: 1.5
        strength_quality_steps: 1
        maximum_quality_multiplier: 1.2
        nausea_multiplier: 0.5
        residue_dose: 0
      } }
  }
  presentation { icon_id: "meridian_witch:imbibe" display_name: "服药"
    description: "这是上卷《养》里的功夫，游炁境界就能练。右手拿瓶拔塞，它只认苦黄膏和聚气汤。连啜三口，手抚胸口把药引下去，得用两腿经脉里的 0.3 元真元。起手费 3.2 秒，再缓 1.8 秒收手，挨了打就前功尽弃，好在药还在瓶里。挪步只有平日四成快。咽下去药力升一品，本是优质的再强两成，药效长一倍半，反胃也只剩一半。记着，隔 15 秒才能再服下一回。" }
}
definitions {
  id: "meridian_witch:anoint"
  version: 1
  category: RECOVERY
  minimum_realm: WANDERING_QI
  movement_speed_multiplier: 0.4
  brew_item {
    kind_ids: "meridian_brewing:bitter_yellow"
    physical_uses: DRINK
    empty_off_hand: true
  }
  slots {
    id: "meridians"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 1
    maximum_count: 6
    require_opened: true
  }
  slots {
    id: "muscles"
    module: TISSUE
    tags: "human:arm_muscle"
    minimum_count: 1
    maximum_count: 16
  }
  cost {
    qi {
      slot_id: "meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: FREE
      amount { value: 0.3 unit: QI }
      distribution: EVEN
    }
  }
  phases {
    warmup_millis: 2600
    active_millis: 0
    recovery_millis: 1400
    interruptible_by_damage: true
  }
  cooldown_millis: 15000
  # 敷两臂、敷两腿两段动作由炼药在起手按伤势选组后播，收势结束停；所以这一式不写 presentation 效果。
  effects {
    at_millis: 0
    use_brew {
      processor_id: "meridian_brewing:anoint_start"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      use_methods: DRINK
    }
  }
  effects {
    at_millis: 0
    work {
      slot_id: "muscles"
      force { value: 0 unit: NEWTON }
      power { value: 10 unit: WATT }
      duration { value: 1.5 unit: SECOND }
    }
  }
  effects {
    at_millis: 250
    sound { sound_id: "meridian_witch:cork"
      volume { value: 0.5 unit: RATIO }
      pitch { value: 1.8 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 700
    sound { sound_id: "meridian_witch:anoint.pour"
      volume { value: 0.5 unit: RATIO }
      pitch { value: 1.3 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 1200
    use_brew {
      processor_id: "meridian_brewing:use_brew"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      use_methods: DRINK
      technique {
        method: ANOINT
        strength_multiplier: 1.5
        duration_multiplier: 1
        strength_quality_steps: 0
        maximum_quality_multiplier: 1
        nausea_multiplier: 0
        residue_dose: 0
      }
      preparation_sound { sound_id: "meridian_witch:anoint.rub"
        volume { value: 0.5 unit: RATIO }
        pitch { value: 0.9 unit: RATIO }
        anchor: CASTER }
      sound_group: ARMS
    }
  }
  effects {
    at_millis: 1250
    use_brew {
      processor_id: "meridian_brewing:use_brew"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      use_methods: DRINK
      technique {
        method: ANOINT
        strength_multiplier: 1.5
        duration_multiplier: 1
        strength_quality_steps: 0
        maximum_quality_multiplier: 1
        nausea_multiplier: 0
        residue_dose: 0
      }
      preparation_sound { sound_id: "meridian_witch:anoint.rub"
        volume { value: 0.5 unit: RATIO }
        pitch { value: 1.1 unit: RATIO }
        anchor: CASTER }
      sound_group: LEGS
    }
  }
  effects {
    at_millis: 1550
    use_brew {
      processor_id: "meridian_brewing:use_brew"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      use_methods: DRINK
      technique {
        method: ANOINT
        strength_multiplier: 1.5
        duration_multiplier: 1
        strength_quality_steps: 0
        maximum_quality_multiplier: 1
        nausea_multiplier: 0
        residue_dose: 0
      }
      preparation_sound { sound_id: "meridian_witch:anoint.rub"
        volume { value: 0.5 unit: RATIO }
        pitch { value: 1.1 unit: RATIO }
        anchor: CASTER }
      sound_group: LEGS
    }
  }
  effects {
    at_millis: 1900
    use_brew {
      processor_id: "meridian_brewing:use_brew"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      use_methods: DRINK
      technique {
        method: ANOINT
        strength_multiplier: 1.5
        duration_multiplier: 1
        strength_quality_steps: 0
        maximum_quality_multiplier: 1
        nausea_multiplier: 0
        residue_dose: 0
      }
      preparation_sound { sound_id: "meridian_witch:anoint.rub"
        volume { value: 0.5 unit: RATIO }
        pitch { value: 1.1 unit: RATIO }
        anchor: CASTER }
      sound_group: LEGS
    }
  }
  effects {
    at_millis: 2100
    use_brew {
      processor_id: "meridian_brewing:use_brew"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      use_methods: DRINK
      technique {
        method: ANOINT
        strength_multiplier: 1.5
        duration_multiplier: 1
        strength_quality_steps: 0
        maximum_quality_multiplier: 1
        nausea_multiplier: 0
        residue_dose: 0
      }
      preparation_sound { sound_id: "meridian_witch:anoint.rub"
        volume { value: 0.5 unit: RATIO }
        pitch { value: 0.9 unit: RATIO }
        anchor: CASTER }
      sound_group: ARMS
    }
  }
  effects {
    at_millis: 2200
    use_brew {
      processor_id: "meridian_brewing:use_brew"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      use_methods: DRINK
      technique {
        method: ANOINT
        strength_multiplier: 1.5
        duration_multiplier: 1
        strength_quality_steps: 0
        maximum_quality_multiplier: 1
        nausea_multiplier: 0
        residue_dose: 0
      }
      preparation_sound { sound_id: "meridian_witch:anoint.rub"
        volume { value: 0.5 unit: RATIO }
        pitch { value: 1.1 unit: RATIO }
        anchor: CASTER }
      sound_group: LEGS
    }
  }
  effects {
    at_millis: 2550
    use_brew {
      processor_id: "meridian_brewing:use_brew"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      use_methods: DRINK
      technique {
        method: ANOINT
        strength_multiplier: 1.5
        duration_multiplier: 1
        strength_quality_steps: 0
        maximum_quality_multiplier: 1
        nausea_multiplier: 0
        residue_dose: 0
      }
      preparation_sound { sound_id: "meridian_witch:anoint.pat"
        volume { value: 0.4 unit: RATIO }
        pitch { value: 1.4 unit: RATIO }
        anchor: CASTER }
      sound_group: LEGS
    }
  }
  effects {
    at_millis: 2600
    use_brew { processor_id: "meridian_brewing:use_brew"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      use_methods: DRINK
      technique {
        method: ANOINT
        strength_multiplier: 1.5
        duration_multiplier: 1
        strength_quality_steps: 0
        maximum_quality_multiplier: 1
        nausea_multiplier: 0
        residue_dose: 0
      } }
  }
  presentation { icon_id: "meridian_witch:anoint" display_name: "敷药"
    description: "当年我在泥塘里摔伤了腿，就靠这手敷药撑回了家。也是《养》卷里的，单用能喝的苦黄膏。右手拿紧药瓶，左手必须空着去抹药。瞧瞧两臂和两腿哪处伤重就抹哪处，伤得一样就先抹两臂。两臂使劲揉，耗去两臂经脉 0.3 元真元。抹药耗 2.6 秒，缓 1.4 秒收手，步子挪得慢，挨打也会断。敷上去药力比喝强一半，丁点不反胃，可品级不涨，隔 15 秒才能再敷。" }
}
definitions {
  id: "meridian_witch:lob_seed"
  version: 1
  category: ATTACK
  minimum_realm: TRUE_QI
  movement_speed_multiplier: 0.4
  projectile_weapon: HELD_SPLASH_BREW
  brew_item {
    kind_ids: "meridian_brewing:depletion"
    kind_ids: "meridian_brewing:armor_rot"
    kind_ids: "meridian_brewing:insect_lure"
    kind_ids: "meridian_brewing:bitter_yellow"
    kind_ids: "meridian_brewing:charm"
    physical_uses: SPLASH
    empty_off_hand: false
  }
  slots {
    id: "meridians"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 1
    maximum_count: 6
    require_opened: true
  }
  slots {
    id: "muscles"
    module: TISSUE
    tags: "human:arm_muscle"
    minimum_count: 1
    maximum_count: 16
  }
  cost {
    qi {
      slot_id: "meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: GAS
      amount { value: 0.5 unit: QI }
      distribution: EVEN
    }
  }
  phases {
    warmup_millis: 1000
    active_millis: 0
    recovery_millis: 1200
    interruptible_by_damage: true
  }
  cooldown_millis: 6000
  effects { at_millis: 0 presentation { id: "meridian_witch:witch_lob_seed" duration: UNTIL_RECOVERY_END start_millis: 0 } }
  effects {
    at_millis: 0
    work {
      slot_id: "muscles"
      force { value: 0 unit: NEWTON }
      power { value: 20 unit: WATT }
      duration { value: 0.4 unit: SECOND }
    }
  }
  effects {
    at_millis: 150
    sound { sound_id: "meridian_witch:lob_seed.shake"
      volume { value: 0.4 unit: RATIO }
      pitch { value: 1.5 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 1000
    sound { sound_id: "meridian_witch:lob_seed.throw"
      volume { value: 0.5 unit: RATIO }
      pitch { value: 0.8 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 1000
    launch_projectile {
      projectile_weapon: HELD_SPLASH_BREW
      speed_multiplier { value: 1 unit: RATIO }
      damage_multiplier { value: 1 unit: RATIO }
      critical: false
      piercing: 0
      spread { value: 0 unit: DEGREE }
      multiply_draw_strength: false
      shield_cooldown_millis: 0
      mirror_by_hand: false
      lob {
        maximum_distance { value: 16 unit: METER }
        radius { value: 0 unit: METER }
        elevation { value: 50 unit: DEGREE }
        maximum_speed_multiplier { value: 4 unit: RATIO }
      }
      brew { processor_id: "meridian_brewing:use_brew"
        brew_kind_ids: "meridian_brewing:depletion"
        brew_kind_ids: "meridian_brewing:armor_rot"
        brew_kind_ids: "meridian_brewing:insect_lure"
        brew_kind_ids: "meridian_brewing:bitter_yellow"
        brew_kind_ids: "meridian_brewing:charm"
        use_methods: SPLASH
        technique {
          method: THROW
          strength_multiplier: 1
          duration_multiplier: 1
          strength_quality_steps: 0
          maximum_quality_multiplier: 1
          nausea_multiplier: 1
          residue_dose: 1
        } }
    }
  }
  presentation { icon_id: "meridian_witch:lob_seed" display_name: "掷引"
    description: "学会了《养》卷，到了真炁境界经脉有了气态真元，才能练下卷《引》的掷引。右手拿起枯竭药水、蚀甲水、招虫水、苦黄膏或魅惑药水，举瓶高高抛出，划道大弧落在对手脚下，没对准就落你眼瞅的地上，最远 16 格。起手 1 秒出手，缓 1.2 秒收手，耗 0.5 元气态真元。身子挪得慢，挨打就断。药水沾上谁，谁身上就落下这味药的药引，隔 6 秒才能再掷一回。" }
}
definitions {
  id: "meridian_witch:fling_seed"
  version: 1
  category: ATTACK
  minimum_realm: TRUE_QI
  movement_speed_multiplier: 0.4
  brew_item {
    kind_ids: "meridian_brewing:depletion"
    kind_ids: "meridian_brewing:armor_rot"
    kind_ids: "meridian_brewing:insect_lure"
    kind_ids: "meridian_brewing:bitter_yellow"
    kind_ids: "meridian_brewing:charm"
    physical_uses: SPLASH
    empty_off_hand: false
  }
  slots {
    id: "meridians"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 1
    maximum_count: 6
    require_opened: true
  }
  slots {
    id: "muscles"
    module: TISSUE
    tags: "human:arm_muscle"
    minimum_count: 1
    maximum_count: 16
  }
  cost {
    qi {
      slot_id: "meridians"
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      phase: GAS
      amount { value: 0.4 unit: QI }
      distribution: EVEN
    }
  }
  phases {
    warmup_millis: 800
    active_millis: 0
    recovery_millis: 1000
    interruptible_by_damage: true
  }
  cooldown_millis: 5000
  effects { at_millis: 0 presentation { id: "meridian_witch:witch_fling_seed" duration: UNTIL_RECOVERY_END start_millis: 0 } }
  effects {
    at_millis: 0
    work {
      slot_id: "muscles"
      force { value: 0 unit: NEWTON }
      power { value: 20 unit: WATT }
      duration { value: 0.5 unit: SECOND }
    }
  }
  effects {
    at_millis: 150
    sound { sound_id: "meridian_witch:cork"
      volume { value: 0.5 unit: RATIO }
      pitch { value: 1.8 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 800
    sound { sound_id: "meridian_witch:fling_seed.splash"
      volume { value: 0.5 unit: RATIO }
      pitch { value: 1.4 unit: RATIO }
      anchor: CASTER }
  }
  effects {
    at_millis: 800
    use_brew { processor_id: "meridian_brewing:use_brew"
      brew_kind_ids: "meridian_brewing:depletion"
      brew_kind_ids: "meridian_brewing:armor_rot"
      brew_kind_ids: "meridian_brewing:insect_lure"
      brew_kind_ids: "meridian_brewing:bitter_yellow"
      brew_kind_ids: "meridian_brewing:charm"
      use_methods: SPLASH
      technique {
        method: FAN
        strength_multiplier: 1
        duration_multiplier: 1
        strength_quality_steps: 0
        maximum_quality_multiplier: 1
        nausea_multiplier: 1
        residue_dose: 1
        range { value: 3.5 unit: METER }
        fan_angle { value: 70 unit: DEGREE }
        maximum_targets: 4
      } }
  }
  presentation { icon_id: "meridian_witch:fling_seed" display_name: "泼引"
    description: "要是近处围上来人，就使这招泼引。用的也是枯竭药水、蚀甲水、招虫水、苦黄膏或魅惑药水那五样喷溅药。把药往面前一泼，泼出片宽宽的扇面，面前 3 格半以内、左右约七十度宽，最多能泼中 4 个人，但隔着遮挡可泼不着。起手要 0.8 秒，再缓 1 秒收手，耗 0.4 元气态真元。出招时脚下慢，挨打也会断。泼中的人身上全留下药引，隔 5 秒才能再泼。" }
}
